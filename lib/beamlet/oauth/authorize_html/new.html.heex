<Layouts.app current_user={@current_user}>
  <h1 class="text-2xl font-semibold">Connect {@client_host} to your beamlet</h1>
  <p id="client-id" class="mt-2 break-all text-xs text-zinc-500">{@request.client_id}</p>
  <p class="mt-4">
    {@client_host} is asking to work on your beamlet as you. Choose what it may do, then allow it.
  </p>

  <p :if={@loopback?} id="loopback-warning" class="mt-4 rounded bg-amber-50 p-3 text-sm text-amber-900">
    This app is running on your own computer. Allowing sends it a code at {@request.redirect_uri}.
  </p>

  <.form for={%{}} as={:none} action="/beamlet/authorize" method="post" id="consent-form" class="mt-6 flex flex-col gap-4">
    <input :for={{name, value} <- @request} :if={value} type="hidden" name={name} value={value} />

    <fieldset class="flex flex-col gap-2">
      <legend class="text-sm font-medium">What may it do on your beamlet?</legend>
      <label :for={{name, tools} <- @policies} class="flex items-center gap-2 text-sm">
        <input type="radio" name="policy" value={name} checked={name == @selected} />
        <span class="font-mono">{name}</span>
        <span class="text-zinc-500">{tools}</span>
      </label>
    </fieldset>

    <div class="flex gap-3">
      <button type="submit" name="decision" value="allow" class="rounded bg-zinc-900 px-4 py-2 text-white">
        Allow
      </button>
      <button type="submit" name="decision" value="deny" class="rounded border px-4 py-2">
        Deny
      </button>
    </div>
  </.form>
</Layouts.app>
