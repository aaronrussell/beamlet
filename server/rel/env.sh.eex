#!/bin/sh

# The release never runs as root. The image starts as root to set its
# firewall, and `docker exec` and `fly ssh console` arrive as root, so
# every command of the release, `bin/beamlet` included, starts over
# here as `beamlet` with no capabilities: code past the policy must
# not hold what could undo the rules, `eval` must not run the
# operator file with root's rights, and what a command writes in the
# data dir must stay the server's to open. setpriv keeps the
# environment, root's HOME included, so HOME points nowhere.
if [ "$(id -u)" = 0 ]; then
  if ! id beamlet >/dev/null 2>&1; then
    echo "$RELEASE_PROG does not run as root, and there is no beamlet user to run as." >&2
    exit 1
  fi

  HOME=/nonexistent
  export HOME
  exec setpriv --reuid=beamlet --regid=beamlet --init-groups \
    --inh-caps=-all --bounding-set=-all --no-new-privs "$SELF" "$@"
fi
